{
  "framework": null,
  "installCommand": "echo skip-install",
  "buildCommand": "node scripts/prepare-vercel-shopper.js",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/vendor-listing-info", "destination": "https://vfm.buzzonmarketing.com/vendors", "permanent": false },
    { "source": "/vendor-listing-info/", "destination": "https://vfm.buzzonmarketing.com/vendors", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "www.visitfirstmonday.com" }], "destination": "/vfm-home.html" },
    { "source": "/", "has": [{ "type": "host", "value": "visitfirstmonday.com" }], "destination": "/vfm-home.html" },
    { "source": "/index.html", "has": [{ "type": "host", "value": "www.visitfirstmonday.com" }], "destination": "/vfm-home.html" },
    { "source": "/index.html", "has": [{ "type": "host", "value": "visitfirstmonday.com" }], "destination": "/vfm-home.html" },
    { "source": "/", "destination": "/marketing.html" },
    { "source": "/index.html", "destination": "/marketing.html" },
    { "source": "/app-download", "destination": "/app-download.html" },
    { "source": "/app-download/", "destination": "/app-download.html" },
    { "source": "/vfm-home", "destination": "/vfm-home.html" },
    { "source": "/first-monday-finder", "destination": "/first-monday-finder.html" },
    { "source": "/api/locations", "destination": "/data/mapme-full-export.json" },
    { "source": "/api/config.js", "destination": "/api/config.js" },
    { "source": "/api/tile", "destination": "/api/tile" },
    { "source": "/api/venue-tile/:path*", "destination": "/api/venue-tile/:path*" },
    { "source": "/api/:path*", "destination": "https://thefairmap-production.up.railway.app/api/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/signup", "destination": "/signup.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/platform/login", "destination": "/vendor-login.html" },
    { "source": "/vendor-login", "destination": "/vendor-login.html" },
    { "source": "/vendors/login", "destination": "/vendor-login.html" },
    { "source": "/vendors/dashboard", "destination": "/vendor-dash.html" },
    { "source": "/vendors/claim", "destination": "/vendor-claim.html" },
    { "source": "/platform", "destination": "/platform.html" },
    { "source": "/analytics", "destination": "/analytics.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/data/(locations|mapme-full-export|published-listings).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    },
    {
      "source": "/api/locations",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" }
      ]
    }
  ]
}
